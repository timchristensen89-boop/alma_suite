{
  "expo": {
    "name": "ALMA POS",
    "slug": "alma-pos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "au.com.almagroup.pos",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan gift cards and QR codes at the register."
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ]
  }
}
