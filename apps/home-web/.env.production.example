# Home frontend (alma-home.web.app)
#
# Copy to .env.production before building. Every value here is a public URL —
# no secrets live in this file. scripts/validate-vite-production-env.mjs
# refuses the build if any of them is missing, which is what happened on
# 2026-08-31: home-web was the one app with no example to copy, so the file
# was never created and the whole-suite deploy stopped at alma-home.
VITE_API_URL=https://api.almagroup.com.au
VITE_API_BASE_URL=https://api.almagroup.com.au

# Cross-app links in the launcher.
VITE_ADMIN_WEB_URL=https://alma-suite-admin.web.app
VITE_SETTINGS_WEB_URL=https://alma-suite-admin.web.app
VITE_COMPLIANCE_WEB_URL=https://alma-compliance.web.app
VITE_STAFF_WEB_URL=https://alma-staff.web.app
VITE_STOCK_WEB_URL=https://alma-stock-v18.web.app
VITE_REPORTS_WEB_URL=https://alma-reports.web.app
VITE_GIFTCARDS_WEB_URL=https://alma-giftcards.web.app
VITE_RESERVE_WEB_URL=https://alma-reserve.web.app
VITE_MARKETING_WEB_URL=https://alma-marketing.web.app
VITE_COMMS_WEB_URL=https://alma-comms.web.app
