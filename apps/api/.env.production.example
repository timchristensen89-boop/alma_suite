# Production bootstrap/import. Do not use demo seed data in production.
ALMA_ORG_NAME=Alma Group
ALMA_PRIMARY_CONTACT_NAME=Tim Christensen
ALMA_PRIMARY_CONTACT_EMAIL=tim@almagroup.com.au 
ALMA_PRIMARY_CONTACT_PHONE=0430058410   
ALMA_VENUES_JSON=[{"name":"Alma Avalon","slug":"alma-avalon"},{"name":"St Alma","slug":"st-alma"}]
PROD_ADMIN_EMAIL=
PROD_ADMIN_PASSWORD=
PROD_ADMIN_FIRST_NAME=
PROD_ADMIN_LAST_NAME=
PROD_ADMIN_ROLE=Production Admin
ALMA_CONTROL_IMPORT_FILE=tmp/alma-control-export.json
ALMA_CONTROL_TRUSTED_OPENING_BALANCES=false
COMMS_WEB_URL=https://alma-comms.web.app

# Gift card wallet passes. Buttons stay hidden until these are set, so it is
# safe to deploy without them.
# Apple: certificates from the Apple Developer portal (PEM, raw or base64).
APPLE_WALLET_PASS_TYPE_IDENTIFIER=
APPLE_WALLET_TEAM_IDENTIFIER=
APPLE_WALLET_ORGANIZATION_NAME=ALMA Group
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_CERT=
# Google: the issuer id from the Google Pay & Wallet console, and the
# service-account key file exactly as Google Cloud downloads it (raw JSON or
# base64) — nothing needs extracting from it.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# Or, instead of the JSON: the two fields pulled out by hand.
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=
# Optional overrides.
# GOOGLE_WALLET_CLASS_SUFFIX=alma_gift_card
# GOOGLE_WALLET_ORIGINS=https://www.almagroup.com.au,https://alma-giftcards.web.app

# --- Roster push notifications (VAPID) ---------------------------------------
# Staff phones get a notification when a roster is published. Without these the
# "Tell me when the roster drops" card hides itself and the email still goes —
# the feature degrades, nothing breaks.
#
# Generate the pair once, on the server, and never paste the private key
# anywhere else:
#
#   docker compose run --rm suite-api node -e \
#     "const w=require('web-push');const k=w.generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey);console.log('VAPID_PRIVATE_KEY='+k.privateKey)"
#
# Rotating the pair invalidates every existing subscription: staff have to tap
# "Notify me on this device" again. Their rows are pruned automatically on the
# first send after that, so there is nothing to clean up by hand.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identifies us to the push services. Must be a mailto: or https: URL — they
# reject a VAPID header without one, and some of them use it to get in touch
# when a sending pattern looks wrong.
VAPID_SUBJECT=mailto:tim@almagroup.com.au
