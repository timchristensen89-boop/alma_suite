SQUARE_ENVIRONMENT=production
SQUARE_API_VERSION=2025-12-17
SQUARE_WEBHOOK_URL=https://alma-compliance-api-433873385316.australia-southeast1.run.app/api/integrations/square/webhook
TIPS_ABA_FINANCIAL_INSTITUTION=
TIPS_ABA_USER_NAME=
TIPS_ABA_USER_ID=
