  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, obligationType, periodStart])
  @@index([companyId, dueDate])
  @@map("fc_tax_obligations")
}

// ── Creditors ──────────────────────────────────────────────────────────────

model FcCreditorClaim {
  id                       String          @id @default(cuid())
  companyId                String
  creditorName             String
  creditorClass            FcCreditorClass @default(EXTERNAL_TRADE)
  relatedParty             Boolean         @default(false)
  secured                  Boolean         @default(false)
  priority                 Boolean         @default(false)
  claimedAmountCents       Int             @default(0)
  admittedAmountCents      Int?
