// @domain: stock | home: suite
model Recipe {
  id                 String                    @id @default(cuid())
  legacyId           String?                   @unique
  title              String
  /// Kitchen docket / KDS override name. NULL = dockets print `title`, same
  /// as the register tile. Set this when the register-facing name and what
  /// the kitchen needs to see should differ (e.g. a long menu name vs. a
  /// short kitchen shorthand). Never read by the register tile or receipts —
  /// only by docket/KDS building, and only as of the moment a line is added
  /// to an order (PosOrderLine.printName is a snapshot, not a live join, so
  /// editing this never rewrites a ticket already fired).
  printTitle         String?
  kind               String?
  category           String?
  subcategory        String?
  venue              String?
  salePriceCents     Int?
  portionSize        Float?
  portionUnit        String?
  yieldQuantity      Float?
  yieldUnit          String?
  isPrepRecipe       Boolean                   @default(false)
  status             String                    @default("ACTIVE")
  estimatedCost      Float                     @default(0)
  /// INTERNAL. Kitchen and back-office notes — prep reminders, supplier
  /// quirks, "use the small pan". Never shown to a guest; the QR menu reads
  /// `guestDescription` instead, precisely so that writing freely in here
  /// stays safe.
  notes              String?
  /// What a GUEST reads under the dish name on the QR menu.
  ///
  /// Separate from `notes` on purpose: one is written for the kitchen and the
  /// other is published to whoever scans the code on the table. Seeded from
  /// the printed menus' own descriptions, which are already the guest-facing
  /// copy and already signed off — "Corn chips, wakame", "Pico de gallo,
  /// guacachile, three pieces".
  ///
  /// NULL means no copy yet, and the menu simply shows the dish name.
  guestDescription   String?
  // What this dish is, dietary-wise: a list of DISH_DIETARY ids
  // (packages/shared/src/dietary.ts) — 'gf', 'vgn', 'nuts' and so on.
  //
  // Empty means NOBODY HAS CHECKED, not "no allergens". Everything that reads
  // this must treat an empty list as unknown; dishAnswersGuest is the one
  // place that decides, and it is tested for exactly this.
  dietary            Json                      @default("[]")
  /// The venue-twin link. The catalogue is duplicated per venue (each venue
  /// carries its own copy of the same dish under a different id); twins point
  /// at ONE canonical member of their group (which keeps this null). Nothing
  /// merges — sales history, costing and per-venue prices stay put — but the
  /// POS and mappings resolve cross-venue references through this instead of
  /// fragile title matching. Backfilled by scripts/link-recipe-twins.ts.
  canonicalId        String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  lines              RecipeLine[]              @relation("RecipeLines")
  posOrderLines      PosOrderLine[]
  usedByLines        RecipeLine[]              @relation("SubRecipeLines")
  itemSales          SalesItemActualEntry[]
  squareMenuMappings SquareMenuRecipeMapping[]
  venuePrices        RecipeVenuePrice[]
  setMenuCourses     SetMenuCourse[]
  offeredOn          SetMenuOption[]
  winePour           WinePour?

  @@index([title])
  @@index([category])
  @@index([isPrepRecipe])
  @@index([canonicalId])
  @@index([status])
}

