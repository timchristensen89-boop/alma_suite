// @domain: compliance | home: suite
model Issue {
  id              String           @id @default(cuid())
  legacyId        String?          @unique
  title           String
  description     String
  severity        IssueSeverity
  category        String
  area            String?
  status          IssueStatus      @default(OPEN)
  assignee        String?
  dueDate         DateTime?
  notes           String?
  resolutionNotes String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  evidence        IssueEvidence[]
  activities      IssueActivity[]
  checklistLinks  ChecklistItem[]
  auditLinks      AuditFinding[]
  incidentLinks   IncidentReport[]
}

// @domain: compliance | home: suite
model IssueEvidence {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  issueId   String
  name      String
  url       String
  fileType  String?
  note      String?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

// Area → default responsible person. When an issue is created/assigned to an
// area, it is auto-assigned to this person (Issue.assignee is free text, so we
// store the display name to match). Managed in Admin → Compliance settings.
// @domain: compliance | home: suite
model IssueAreaRule {
  id        String   @id @default(cuid())
  area      String   @unique
  assignee  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-managed list of issue categories. Staff pick from these in the
// issue form (free-text only when none are configured).
// @domain: compliance | home: suite
model IssueCategoryOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// @domain: compliance | home: suite
model IssueActivity {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  issueId   String
  action    String
  message   String
  actor     String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

// @domain: compliance | home: suite
model ChecklistTemplate {
  id                   String                  @id @default(cuid())
  legacyId             String?                 @unique
  name                 String
  area                 String?
  items                ChecklistItemTemplate[]
  runs                 ChecklistRun[]
  shiftTaskRules       ShiftTaskRule[]
  shiftTaskAssignments ShiftTaskAssignment[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
}

// @domain: compliance | home: suite
model ChecklistItemTemplate {
  id          String            @id @default(cuid())
  legacyId    String?           @unique
  templateId  String
  label       String
  description String?
  position    Int
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// @domain: compliance | home: suite
model ChecklistRun {
  id                   String                @id @default(cuid())
  legacyId             String?               @unique
  templateId           String
  runDate              DateTime              @default(now())
  status               ChecklistRunStatus    @default(OPEN)
  area                 String?
  performedBy          String?
  notes                String?
  template             ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items                ChecklistItem[]
  shiftTaskAssignments ShiftTaskAssignment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

// @domain: compliance | home: suite
model ChecklistItem {
  id             String              @id @default(cuid())
  legacyId       String?             @unique
  runId          String
  templateItemId String?
  label          String
  description    String?
  position       Int
  result         ChecklistItemResult @default(PENDING)
  notes          String?
  linkedIssueId  String?
  run            ChecklistRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  linkedIssue    Issue?              @relation(fields: [linkedIssueId], references: [id])
}

// @domain: compliance | home: suite
model AuditTemplate {
  id        String                 @id @default(cuid())
  legacyId  String?                @unique
  name      String
  sections  AuditTemplateSection[]
  runs      AuditRun[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

// @domain: compliance | home: suite
model AuditTemplateSection {
  id          String        @id @default(cuid())
  legacyId    String?       @unique
  templateId  String
  title       String
  description String?
  position    Int
  template    AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// @domain: compliance | home: suite
model AuditRun {
  id         String         @id @default(cuid())
  legacyId   String?        @unique
  templateId String
  title      String
  score      Float?
  summary    String?
  runDate    DateTime       @default(now())
  template   AuditTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  findings   AuditFinding[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// @domain: compliance | home: suite
model AuditFinding {
  id            String   @id @default(cuid())
  legacyId      String?  @unique
  auditRunId    String
  sectionTitle  String
  finding       String
  score         Float?
  linkedIssueId String?
  auditRun      AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  linkedIssue   Issue?   @relation(fields: [linkedIssueId], references: [id])
}

