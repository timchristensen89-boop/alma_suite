// Manager/admin-initiated movement of stock between venues. Adjusts each
// venue's VenueStockItem.onHand so the next stocktake variance is correct;
// total company stock is unchanged.
// @domain: stock | home: suite
model StockTransfer {
  id              String    @id @default(cuid())
