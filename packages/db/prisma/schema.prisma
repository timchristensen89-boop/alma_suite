  /// Costed, never served.
  ///
  /// A banquet's price has to carry things the kitchen never plates — the
  /// allowance for what a table drinks, most obviously. Those belong in the
  /// margin and nowhere else: an "average drinks" line on a docket is an
  /// instruction to make something that does not exist.
  ///
  /// Until this existed a set menu component had only two possible lives. A
  /// course could serve it, so the table was asked; or nothing did, and the
  /// register put it on every bill and fired it to the kitchen. There was no
  /// way to say "count this and stay quiet", which is why a drinks allowance
  /// could not be costed without printing.
  ///
  /// The costing reads every line regardless. This changes the SERVICE side
  /// only: stillFixed drops these, so they never reach a bill or a docket.
  costingOnly    Boolean    @default(false)
  itemId         String?
  subRecipeId    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  recipe         Recipe     @relation("RecipeLines", fields: [recipeId], references: [id], onDelete: Cascade)
  item           StockItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  subRecipe      Recipe?    @relation("SubRecipeLines", fields: [subRecipeId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([itemId])
  @@index([subRecipeId])
}

// @domain: stock | home: suite
// What a wine is, past a name and a price.
//
// A wine in the catalogue is a Recipe like anything else, and a Recipe has a
// title and a price and nothing else — so "a Riesling under $90 from the Clare"
// is a question the register cannot answer, and the same wine appears as three
// separate items because each pour size is its own row ("BenMarco Malbec
// 150mL", "…250mL", "…750mL").
//
// This is the wine as the list in the guest's hand describes it: one bottle,
// its grape and where it comes from, what it tastes like, what it goes with —
// with the pour sizes hanging off it as WinePour rows. Money stays entirely on
// the Recipe each pour points at; nothing here prices anything.
model Wine {
  id            String     @id @default(cuid())
  venue         String
  producer      String
  /// The bit in quotes on the list — 'Polish Hill', 'Valle de Uco'. Often none.
  cuvee         String?
  /// As printed: one grape, or the blend spelled out ("Grenache Shiraz Mourvedre").
  grape         String?
  region        String?
  /// The list writes a state for Australian wine and a country for imports —
  /// SA, VIC, FRA, ITA. Kept exactly as printed, because that is how the floor
  /// says it.
  origin        String?
  /// NULL = non-vintage.
  vintage       Int?
  /// The menu's own heading: Riesling, Chardonnay, Other reds, Bubbles.
  section       String?
  /// The menu's sub-heading: "Crisp & refreshing", "Full-bodied & bold".
  styleBand     String?
  /// The printed pairing marks: 's' seafood & ceviche, 'r' rich & grilled,
  /// 'v' vegetables & cheese.
  pairsWith     String[]
  tastingNote   String?
  /// The premium by-the-glass tier the list sets apart.
  sommelierPour Boolean    @default(false)
  /// The list's "**": on hand now, not reliably re-orderable.
  limitedStock  Boolean    @default(false)
  serveChilled  Boolean    @default(false)
  /// Running order inside the section, so the register lists it the way the
  /// printed menu does.
  sortOrder     Int        @default(0)
  status        String     @default("ACTIVE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  pours         WinePour[]

  @@index([venue, section, sortOrder])
  @@index([grape])
  @@index([region])
}

// @domain: stock | home: suite
// One pour size of a wine, pointing at the POS item that carries its price.
// 150 and 250 for a glass, 750 for the bottle; 60 and 375 for the fortified.
// The price is NOT here on purpose — it lives on the Recipe, where the till,
// the reports and the venue overrides already read it.
model WinePour {
  id        String @id @default(cuid())
  wineId    String
  /// Unique: a POS item is one pour of one wine, never shared.
  recipeId  String @unique
  ml        Int
  sortOrder Int    @default(0)
  wine      Wine   @relation(fields: [wineId], references: [id], onDelete: Cascade)
  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([wineId, ml])
  @@index([wineId])
}

// @domain: stock | home: suite
// A course inside a set menu that somebody has to CHOOSE from — "one entrée
// each, from these three". The parts nobody chooses (bread for the table,
// the greens between four) stay as RecipeLine rows on the set menu itself;
// only the decisions live here.
//
// Deliberately not RecipeLine rows: a pick-one-of-three has no single cost to
// fold into estimatedCost, because what a banquet costs depends on what the
// tables actually picked. That's recorded per sale on PosOrderLine, and the
// banquet report reads it back from there.
model SetMenuCourse {
  id              String          @id @default(cuid())
  setMenuRecipeId String
  name            String
  /// Which POS course these dishes fire on — matches PosOrderLine.course, so
  /// banquet dishes group with everything else on the fire screen and the
  /// dockets. NULL = the register's default for the dish's kind.
  posCourse       String?
  /// How many each guest picks from this course. 1 = one each (the normal
  /// case); 2 = two entrées each. covers x pick = what the table owes before
  /// the picker will let service move on.
  pick            Int             @default(1)
  /// One serve feeds this many guests — the shared sides and the whole fish.
  /// The register divides by it, so a side shared between 4 prints 2 portions
  /// for a table of 8 rather than 8. NULL = one serve each, the normal case.
  /// Mirrors RecipeLine.perGuests, which is where the costing already says it.
  perGuests       Int?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  setMenu         Recipe          @relation(fields: [setMenuRecipeId], references: [id], onDelete: Cascade)
  options         SetMenuOption[]

  @@index([setMenuRecipeId, sortOrder])
}

// @domain: stock | home: suite
// One dish offered under a course. `available` is tonight's menu — the kitchen
// turns options on and off as the week changes, and the register only offers
// what is on. Editing this never rewrites history: what a table was served is
// on their PosOrderLine rows, not here.
model SetMenuOption {
  id              String        @id @default(cuid())
  courseId        String
  recipeId        String
  /// Charged on top of the package price, per guest who picks it — the eye
  /// fillet upgrade. 0 (the normal case) rings at $0 and prints "incl.".
  supplementCents Int           @default(0)
  available       Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  course          SetMenuCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([courseId, recipeId])
  @@index([recipeId])
}

// @domain: stock | home: suite
model Supplier {
  id             String                  @id @default(cuid())
  legacyId       String?                 @unique
  name           String
  contactName    String?
  email          String?
  phone          String?
  website        String?
  address        String?
  accountNumber  String?
  paymentTerms   String?
  notes          String?
  status         SupplierStatus          @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  invoices       SupplierInvoice[]
  deliveryChecks StockDeliveryCheck[]
  purchaseOrders PurchaseOrder[]
  priceListItems SupplierPriceListItem[]
  itemAliases    StockItemAlias[]

  @@index([status])
  @@index([name])
}

// @domain: stock | home: suite
// Purchase-order lifecycle: order → send → receive → 3-way match against the
// invoice. Closes the loop that "orders are just emails" left open.
enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  MATCHED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  supplierId       String?
  supplierName     String
  venue            String?
  reference        String?
  status           PurchaseOrderStatus @default(DRAFT)
  orderedAt        DateTime?
  expectedAt       DateTime?
  receivedAt       DateTime?
  notes            String?
  subtotalCents    Int                 @default(0)
  matchedInvoiceId String?
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  supplier         Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  matchedInvoice   SupplierInvoice?    @relation(fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  lines            PurchaseOrderLine[]

  @@index([supplierId])
  @@index([venue, status])
  @@index([status])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  stockItemId      String?
  description      String
  orderedQuantity  Float
  receivedQuantity Float?
  unit             String?
  unitCostCents    Int           @default(0)
  lineTotalCents   Int           @default(0)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem        StockItem?    @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([stockItemId])
}

model SupplierPriceListItem {
  id            String     @id @default(cuid())
  supplierId    String
  stockItemId   String?
  description   String
  unit          String?
  unitCostCents Int
  effectiveAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  supplier      Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  stockItem     StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@unique([supplierId, stockItemId])
  @@index([supplierId])
  @@index([stockItemId])
}

// @domain: stock | home: suite
model SupplierInvoice {
  id                       String                   @id @default(cuid())
  source                   String                   @default("XERO")
  invoiceKey               String
  externalInvoiceId        String?
  invoiceNumber            String?
  supplierId               String?
  supplierName             String
  supplierEmail            String?
  venue                    String?
  invoiceDate              DateTime?
  dueDate                  DateTime?
  currencyCode             String                   @default("AUD")
  status                   String                   @default("DRAFT")
  subtotalCents            Int                      @default(0)
  taxCents                 Int                      @default(0)
  totalCents               Int                      @default(0)
  sourceFileName           String?
  sourceFileType           String?
  sourceMetadata           Json?
  triageStatus             String                   @default("PENDING")
  triagedAt                DateTime?
  triagedByStaffProfileId  String?
  assignedToStaffProfileId String?
  triageNotes              String?
  importedAt               DateTime                 @default(now())
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  supplier                 Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  triagedBy                StaffProfile?            @relation("SupplierInvoiceTriagedBy", fields: [triagedByStaffProfileId], references: [id], onDelete: SetNull)
  assignedTo               StaffProfile?            @relation("SupplierInvoiceAssignedTo", fields: [assignedToStaffProfileId], references: [id], onDelete: SetNull)
  lines                    SupplierInvoiceLine[]
  matchedPurchaseOrders    PurchaseOrder[]
  document                 SupplierInvoiceDocument?

  @@unique([source, invoiceKey])
  @@index([venue, invoiceDate])
  @@index([supplierId, invoiceDate])
  @@index([externalInvoiceId])
  @@index([invoiceNumber])
  @@index([triageStatus])
  @@index([assignedToStaffProfileId])
}

// The original uploaded invoice file (PDF/photo) kept so a manager can open it
// and key in lines by hand when OCR only reads a total (or misses lines). The
// blob lives in its own table so it never bloats SupplierInvoice list queries.
// @domain: compliance | home: suite
/// A file that belongs to the staff handbook — a policy PDF, a floor plan, a
/// photo of how the pass should look. Stored as bytes in the database rather
/// than an object store because the suite has no bucket wired and these are a
/// handful of small files, the same call SupplierInvoiceDocument makes.
model HandbookDocument {
  id                String   @id @default(cuid())
  title             String
  description       String?
  fileName          String
  mimeType          String
  sizeBytes         Int
  data              Bytes
  venue             String?
  /// Attach to the invite email a new starter receives.
  sendOnOnboarding  Boolean  @default(false)
  position          Int      @default(0)
  uploadedByStaffId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([venue])
  @@index([sendOnOnboarding])
}

model SupplierInvoiceDocument {
  id        String          @id @default(cuid())
  invoiceId String          @unique
  fileName  String?
  mimeType  String
  data      Bytes
  createdAt DateTime        @default(now())
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// @domain: stock | home: suite
/// A supplier's wording for a product, tied to the stock item somebody
/// confirmed it means. Invoice descriptions repeat verbatim month after month
/// — in production the same string recurred up to 13 times — so remembering a
/// human's answer once removes that work permanently.
// @domain: stock | home: stock
model StockItemAlias {
  id          String   @id @default(cuid())
  /// Normalised supplier description. See aliasKey() in @alma/shared.
  aliasKey    String
  /// NULL means "this wording applies whoever sends it".
  supplierId  String?
  stockItemId String
  /// The description exactly as it arrived, for a human reviewing the alias.
  sourceText  String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([aliasKey, supplierId])
  @@index([stockItemId])
  @@map("stock_item_aliases")
}

/// A spelling of a UNIT (not a product): "KILO" means kg, "Unit" means each,
/// "Btl" means bottle. Consulted by the shared unit conversion in
/// @alma/shared stock-units.ts so Loaded counts, invoices and recipe lines
/// all read units the same way. Seeded with the defaults from
/// DEFAULT_UNIT_ALIASES and editable in Stock → Setup → Units; once rows
/// exist they replace the built-in list entirely, so deleting a seeded row
/// really turns it off.
// @domain: stock | home: stock
model StockUnitAlias {
  id          String   @id @default(cuid())
  /// The label as people write it, normalised (lowercase, trimmed).
  alias       String   @unique
  /// The canonical unit token it means ("kg", "each", "bottle").
  canonical   String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("stock_unit_aliases")
}

model SupplierInvoiceLine {
  id                String          @id @default(cuid())
  supplierInvoiceId String
  lineNumber        Int
  lineKey           String
  externalLineId    String?
  description       String
  itemCode          String?
  accountCode       String?
  quantity          Float           @default(0)
  unit              String?
  unitAmountCents   Int             @default(0)
  lineAmountCents   Int             @default(0)
  taxAmountCents    Int             @default(0)
  itemId            String?
  matchingStatus    String          @default("NEEDS_REVIEW")
  notes             String?
  sourceMetadata    Json?
  costAppliedAt     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  invoice           SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  item              StockItem?      @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([supplierInvoiceId, lineKey])
  @@index([supplierInvoiceId, lineNumber])
  @@index([itemId])
  @@index([matchingStatus])
  @@index([itemCode])
}

// @domain: shared | home: suite
model Venue {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  address   String?
  lga       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommsThreadCategory {
  INBOX
  VENUE
  ANNOUNCEMENT
  HANDOVER
  TASK
  ALERT
  GENERAL
}

enum CommsPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CommsAlertType {
  ROSTER_FORECAST_COGS_HIGH
  STOCK_VARIANCE_HIGH
  FRIDGE_TEMP_BREACH
  STAFF_DOCUMENT_EXPIRING
  CHECKLIST_CRITICAL_FAIL
  AUDIT_CRITICAL_ISSUE
  GENERAL
}

enum CommsAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum CommsRecipientMode {
  STAFF
  VENUE
  ROLE
  MANAGERS
  ADMINS
  CUSTOM_EMAILS
}

// @domain: comms | home: suite
model CommsThread {
  id          String              @id @default(cuid())
  subject     String
  venue       String?
  category    CommsThreadCategory @default(GENERAL)
  priority    CommsPriority       @default(NORMAL)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  archivedAt  DateTime?

  messages    CommsMessage[]
  recipients  CommsRecipient[]
  links       CommsLink[]
  alertEvents CommsAlertEvent[]

  @@index([venue, category])
  @@index([priority])
  @@index([archivedAt])
}

// @domain: comms | home: suite
model CommsMessage {
  id          String    @id @default(cuid())
  threadId    String
  body        String
  createdById String?
  createdAt   DateTime  @default(now())
  editedAt    DateTime?

  thread      CommsThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments CommsAttachment[]

  @@index([threadId, createdAt])
}

// @domain: comms | home: suite
model CommsRecipient {
  id             String    @id @default(cuid())
  threadId       String
  staffProfileId String?
  venue          String?
  role           String?
  readAt         DateTime?
  acknowledgedAt DateTime?
  actionRequired Boolean   @default(false)
  dueAt          DateTime?

  thread CommsThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([staffProfileId, readAt])
  @@index([venue, readAt])
  @@index([role, readAt])
  @@index([actionRequired, dueAt])
}

// @domain: comms | home: suite
model CommsAttachment {
  id           String   @id @default(cuid())
  messageId    String
  documentName String
  documentUrl  String
  mimeType     String?
  createdAt    DateTime @default(now())

  message CommsMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// @domain: comms | home: suite
model CommsLink {
  id         String @id @default(cuid())
  threadId   String
  entityType String
  entityId   String

  thread CommsThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([entityType, entityId])
}

// @domain: comms | home: suite
model CommsAlertRule {
  id              String             @id @default(cuid())
  name            String
  enabled         Boolean            @default(true)
  venue           String?
  alertType       CommsAlertType
  thresholdValue  Float?
  thresholdUnit   String?
  recipientMode   CommsRecipientMode @default(MANAGERS)
  recipientEmails Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  events CommsAlertEvent[]

  @@index([enabled, alertType])
  @@index([venue])
}

// @domain: comms | home: suite
model CommsAlertEvent {
  id             String             @id @default(cuid())
  ruleId         String?
  threadId       String?
  alertType      CommsAlertType
  venue          String?
  severity       CommsAlertSeverity @default(WARNING)
  subject        String
  body           String
  sourceType     String?
  sourceId       String?
  value          Float?
  thresholdValue Float?
  emailedAt      DateTime?
  createdAt      DateTime           @default(now())

  rule   CommsAlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  thread CommsThread?    @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([alertType, createdAt])
  @@index([venue, createdAt])
  @@index([severity])
}

// ===================================================================
// Phase 5.8: Unified Task model — one row any app can emit, any
// surface can read. Strategy doc #15.
//
// The model is intentionally cross-cutting: any app (Stock, Compliance,
// Staff, Reports, Reserve, Marketing, Gift Cards, Admin, Comms, Home)
// can call a small `createTaskFromSource()` helper and append a task
// the floor sees on Home + the venue iPad. The source app stays the
// owner of the *thing* that produced the task; this row just lets the
// suite present "what's outstanding" in one consistent shape.
//
// The source link is two plain columns (sourceRefType + sourceRefId)
// rather than a polymorphic relation because it spans many tables and
// would have created a thicket of optional FKs. Lookup by source pair
// is indexed.
// ===================================================================

enum AlmaTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  DISMISSED
}

enum AlmaTaskPriority {
  CRITICAL
  TODAY
  THIS_WEEK
  LOW
}

// Independent of AlmaAppId because that enum drives access control on
// StaffAppAccess and shouldn't grow every time a new task source lands.
enum AlmaTaskSourceApp {
  HOME
  STAFF
  STOCK
  COMPLIANCE
  RESERVE
  MARKETING
  GIFTCARDS
  REPORTS
  ADMIN
  COMMS
}

// @domain: shared | home: suite
model AlmaTask {
  id String @id @default(cuid())

  // Provenance — which app emitted this task and which row in that
  // app's domain it came from. sourceRefType is a string slug (e.g.
  // "stocktake", "issue", "shift", "gift_card_order") so this model
  // doesn't need to know every source schema.
  sourceApp     AlmaTaskSourceApp
  sourceRefType String?
  sourceRefId   String?

  // Scope: venue is a name string to match the rest of the codebase
  // (no Venue table — Stocktake.venue, Issue area, etc. all do this).
  venue String?

  // Display content
  title       String
  description String?

  // Ownership + scheduling
  ownerStaffProfileId String?
  dueAt               DateTime?

  // Status + priority
  status   AlmaTaskStatus   @default(OPEN)
  priority AlmaTaskPriority @default(THIS_WEEK)

  // Lifecycle
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  completedAt               DateTime?
  completedByStaffProfileId String?
  dismissedAt               DateTime?
  dismissedByStaffProfileId String?

  owner       StaffProfile? @relation("AlmaTaskOwner", fields: [ownerStaffProfileId], references: [id], onDelete: SetNull)
  completedBy StaffProfile? @relation("AlmaTaskCompletedBy", fields: [completedByStaffProfileId], references: [id], onDelete: SetNull)
  dismissedBy StaffProfile? @relation("AlmaTaskDismissedBy", fields: [dismissedByStaffProfileId], references: [id], onDelete: SetNull)

  // One outstanding-or-historical task per source object. Backs the
  // createTaskFromSource dedupe so concurrent reconciles on multiple API
  // instances can't insert duplicate tasks for the same source.
  @@unique([sourceApp, sourceRefType, sourceRefId])
  // Read patterns the API will hit:
  //   list open tasks for venue X        → (venue, status)
  //   my open tasks                       → (ownerStaffProfileId, status)
  //   critical/today backlog              → (priority, status)
  //   tasks emitted by app Z              → (sourceApp, status)
  //   the task already linked to source   → (sourceRefType, sourceRefId)
  //   tasks due in the next 24h           → (dueAt)
  @@index([venue, status])
  @@index([ownerStaffProfileId, status])
  @@index([priority, status])
  @@index([sourceApp, status])
  @@index([sourceRefType, sourceRefId])
  @@index([dueAt])
}

// Per-user notification mute. One row = "this user has silenced this
// notification category". Absence = the category is shown. Kept as a
// standalone table (staffProfileId is the AuthUser id; no FK so staff
// archival/merge never blocks on it) with a unique pair so a category
// can't be muted twice for the same user.
// @domain: comms | home: suite
model NotificationMutePreference {
  id             String   @id @default(cuid())
  staffProfileId String
  category       String
  createdAt      DateTime @default(now())

  @@unique([staffProfileId, category])
  @@index([staffProfileId])
}

// Per-user notification read marker. One row = "this user has read/dismissed
// this notification". notificationId is the synthetic, stable id the
// notifications aggregator emits (e.g. "issue-overdue-<id>", "comms-<id>").
// Server-side so read state syncs across every app in the suite — reading an
// alert in one app marks it read everywhere. No FK (staffProfileId is the
// AuthUser id) so staff archival/merge never blocks on it.
// @domain: comms | home: suite
model NotificationRead {
  id             String   @id @default(cuid())
  staffProfileId String
  notificationId String
  readAt         DateTime @default(now())

  @@unique([staffProfileId, notificationId])
  @@index([staffProfileId])
}

// Rules that skip non-supplier documents during stock invoice import
// (e.g. Square sales payouts arriving as PDFs/emails). Each rule holds a
// list of conditions; ALL conditions in a rule must match an invoice for
// it to be excluded, and ANY matching rule excludes the invoice.
// conditions = [{ field: 'title'|'body'|'supplier'|'invoiceNumber', value }]
// @domain: stock | home: suite
model InvoiceExclusionRule {
  id         String   @id @default(cuid())
  name       String
  enabled    Boolean  @default(true)
  conditions Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled])
}

// ═══════════════════════════════════════════════════════════════════════════
// FORECASTING MODULE (fc_*)
//
// Entity-first by design. Every table below carries a REQUIRED companyId, so
// no forecasting query can accidentally span Two Cooked Chooks Pty Ltd and
// Alma Freshwater Pty Ltd. Venue is secondary and optional. See
// docs/forecasting-module.md for why this is additive rather than a retrofit
// onto the 58 venue-keyed models.
//
// Money is integer cents. Rates are Decimal, never Float — these figures
// drive a creditor distribution.
// ═══════════════════════════════════════════════════════════════════════════

/// How a figure came to exist. Every value surfaced in the UI carries one.
enum FcProvenance {
  ACTUAL /// a source transaction (Square, Xero, bank, lodged BAS)
  ACCOUNTING_ESTIMATE /// derived from accounting data by a stated method
  MANAGEMENT_ASSUMPTION /// entered by management
  MODEL_FORECAST /// produced by a model, carries an interval
  MANUAL_OVERRIDE /// deliberate override with author, reason, expiry
  PROPOSAL_TERM /// a creditor proposal term, not a prediction
}

enum FcSourceSystem {
  SQUARE
  XERO
  LIGHTSPEED
  MANUAL
  CSV_IMPORT
  BANK
  DERIVED
}

enum FcNormalisationStatus {
  PENDING
  NORMALISED
  FAILED
  IGNORED
}

enum FcSeverity {
  INFORMATIONAL
  WARNING
  BLOCKING
}

/// Operational grouping that Xero accounts and suppliers are mapped into.
enum FcOperationalGroup {
  SALES
  FOOD_COGS
  BEVERAGE_COGS
  WAGES
  SUPER
  RENT
  CLEANING
  SOFTWARE
  UTILITIES
  MERCHANT_FEES
  INSURANCE
  REPAIRS
  MAINTENANCE
  FINANCE_REPAYMENTS
  INTEREST
  TAX_PAYMENTS
  CREDITOR_DISTRIBUTIONS
  CAPITAL_EXPENDITURE
  DIRECTOR_TRANSACTIONS
  INTERCOMPANY
  EXCLUDED
  UNMAPPED
}

/// Creditor classes. Only EXTERNAL_TRADE (and anything explicitly switched on)
/// participates in the external dividend calculation.
enum FcCreditorClass {
  EXTERNAL_TRADE
  DIRECTOR_LOAN
  INTERCOMPANY
  SECURED
  PRIORITY_EMPLOYEE
  RELATED_PARTY
  CONTINGENT
  STATUTORY
}

// ── Entities ───────────────────────────────────────────────────────────────

/// A legal entity. Cash, creditors and liabilities NEVER cross this boundary.
model FcCompany {
  id           String   @id @default(cuid())
  code         String   @unique /// "TCC" | "AF"
  legalName    String /// "Two Cooked Chooks Pty Ltd"
  tradingName  String /// "Alma Avalon"
  abn          String?
  /// Xero tenant this entity's accounting lives in.
  xeroTenantId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venues               FcVenue[]
  assumptions          FcAssumption[]
  overrides            FcOverride[]
  creditorClaims       FcCreditorClaim[]
  creditorProposals    FcCreditorProposal[]
  forecastRuns         FcForecastRun[]
  bankBalances         FcBankBalanceSnapshot[]
  taxObligations       FcTaxObligation[]
  recurringCommitments FcRecurringCommitment[]
  importJobs           FcImportJob[]
  auditEvents          FcAuditEvent[]
  dataQualityIssues    FcDataQualityIssue[]
  scenarios            FcScenario[]

  @@map("fc_companies")
}

/// A trading venue. Belongs to exactly one legal entity.
model FcVenue {
  id               String  @id @default(cuid())
  companyId        String
  code             String  @unique /// "AVALON" | "FRESHWATER"
  name             String /// "Alma Avalon"
  /// Bridge to the legacy venue-keyed models ("St Alma" | "Alma Avalon").
  legacyVenueName  String? @unique
  squareLocationId String?
  active           Boolean @default(true)

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("fc_venues")
}

// ── Canonical ingestion layer ──────────────────────────────────────────────

/// Immutable raw payload as received. Never edited except for retention.
model FcRawSourceRecord {
  id                  String                @id @default(cuid())
  companyId           String
  venueId             String?
  sourceSystem        FcSourceSystem
  sourceEntity        String /// "order" | "payment" | "payout" | "invoice" …
  sourceId            String
  /// Dedupe key — unique per source system. Re-ingesting is a no-op.
  idempotencyKey      String
  sourceTimestamp     DateTime?
  businessDate        DateTime?
  payload             Json
  payloadHash         String
  normalisationStatus FcNormalisationStatus @default(PENDING)
  normalisationError  String?
  importedAt          DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([sourceSystem, idempotencyKey])
  @@index([companyId, businessDate])
  @@index([sourceSystem, sourceEntity, sourceId])
  @@index([normalisationStatus])
  @@map("fc_raw_source_records")
}

model FcImportJob {
  id             String    @id @default(cuid())
  companyId      String
  datasetKey     String /// "sales_daily" | "bills_due" | …
  fileName       String
  fileHash       String
  mappingProfile Json?
  dryRun         Boolean   @default(true)
  allOrNothing   Boolean   @default(true)
  status         String    @default("PENDING") /// PENDING|VALIDATING|APPLIED|ROLLED_BACK|FAILED
  totalRows      Int       @default(0)
  validRows      Int       @default(0)
  errorRows      Int       @default(0)
  appliedRows    Int       @default(0)
  duplicateRows  Int       @default(0)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  rolledBackAt   DateTime?
  createdById    String?
  createdByLabel String?

  company FcCompany       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rows    FcImportRow[]
  errors  FcImportError[]

  @@index([companyId, datasetKey, startedAt])
  @@map("fc_import_jobs")
}

model FcImportRow {
  id             String  @id @default(cuid())
  importJobId    String
  rowNumber      Int
  raw            Json
  normalised     Json?
  /// Set when the row was applied, so a rollback knows exactly what to undo.
  targetTable    String?
  targetRecordId String?
  duplicateOf    String?
  applied        Boolean @default(false)

  job FcImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, rowNumber])
  @@map("fc_import_rows")
}

model FcImportError {
  id          String     @id @default(cuid())
  importJobId String
  rowNumber   Int?
  column      String?
  severity    FcSeverity @default(BLOCKING)
  code        String
  message     String

  job FcImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("fc_import_errors")
}

/// Xero account code → operational group. Editable in the UI, never in code.
model FcAccountMapping {
  id               String             @id @default(cuid())
  companyId        String
  accountCode      String
  accountName      String
  operationalGroup FcOperationalGroup @default(UNMAPPED)
  isCashflowItem   Boolean            @default(true)
  notes            String?
  updatedAt        DateTime           @updatedAt
  updatedByLabel   String?

  @@unique([companyId, accountCode])
  @@index([companyId, operationalGroup])
  @@map("fc_account_mappings")
}

model FcSupplierMapping {
  id               String             @id @default(cuid())
  companyId        String
  supplierName     String
  normalisedName   String
  operationalGroup FcOperationalGroup @default(UNMAPPED)
  relatedParty     Boolean            @default(false)
  updatedAt        DateTime           @updatedAt

  @@unique([companyId, normalisedName])
  @@map("fc_supplier_mappings")
}

model FcCategoryMapping {
  id               String             @id @default(cuid())
  companyId        String
  sourceCategory   String
  operationalGroup FcOperationalGroup @default(UNMAPPED)
  isBeverage       Boolean            @default(false)
  updatedAt        DateTime           @updatedAt

  @@unique([companyId, sourceCategory])
  @@map("fc_category_mappings")
}

// ── Sales (Square canonical) ───────────────────────────────────────────────

model FcSalesOrder {
  id                 String         @id @default(cuid())
  companyId          String
  venueId            String?
  sourceSystem       FcSourceSystem @default(SQUARE)
  sourceId           String
  businessDate       DateTime
  closedAt           DateTime?
  /// GST-INCLUSIVE gross. Never add this to a GST-exclusive Xero figure.
  grossSalesCents    Int            @default(0)
  netSalesExGstCents Int            @default(0)
  gstCents           Int            @default(0)
  discountsCents     Int            @default(0)
  serviceChargeCents Int            @default(0)
  tipsCents          Int            @default(0)
  refundsCents       Int            @default(0)
  covers             Int?
  transactionCount   Int            @default(1)
  rawRecordId        String?
  createdAt          DateTime       @default(now())

  lines FcSalesOrderLine[]

  @@unique([sourceSystem, sourceId])
  @@index([companyId, businessDate])
  @@index([venueId, businessDate])
  @@map("fc_sales_orders")
}

model FcSalesOrderLine {
  id                 String   @id @default(cuid())
  orderId            String
  companyId          String
  venueId            String?
  businessDate       DateTime
  itemSourceId       String?
  itemName           String
  category           String?
  quantity           Decimal  @db.Decimal(12, 3)
  grossSalesCents    Int      @default(0)
  netSalesExGstCents Int      @default(0)
  discountsCents     Int      @default(0)
  refundsCents       Int      @default(0)
  menuPriceCents     Int?
  unitCogsCents      Int?

  order FcSalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId, businessDate])
  @@index([orderId])
  @@map("fc_sales_order_lines")
}

model FcSalesPayment {
  id            String         @id @default(cuid())
  companyId     String
  venueId       String?
  sourceSystem  FcSourceSystem @default(SQUARE)
  sourceId      String
  orderSourceId String?
  businessDate  DateTime
  createdAt     DateTime       @default(now())
  completedAt   DateTime?
  amountCents   Int
  tipCents      Int            @default(0)
  feeCents      Int            @default(0)
  tenderType    String?
  status        String?
  payoutId      String?

  @@unique([sourceSystem, sourceId])
  @@index([companyId, businessDate])
  @@index([payoutId])
  @@map("fc_sales_payments")
}

model FcSalesRefund {
  id              String         @id @default(cuid())
  companyId       String
  venueId         String?
  sourceSystem    FcSourceSystem @default(SQUARE)
  sourceId        String
  paymentSourceId String?
  businessDate    DateTime
  amountCents     Int
  reason          String?
  status          String?

  @@unique([sourceSystem, sourceId])
  @@index([companyId, businessDate])
  @@map("fc_sales_refunds")
}

/// Actual Square→bank settlement. Cash timing comes from HERE, not sales dates.
model FcSquarePayout {
  id                 String    @id @default(cuid())
  companyId          String
  venueId            String?
  sourceId           String    @unique
  payoutDate         DateTime
  arrivalDate        DateTime?
  grossAmountCents   Int       @default(0)
  feesCents          Int       @default(0)
  refundsCents       Int       @default(0)
  adjustmentsCents   Int       @default(0)
  netPayoutCents     Int
  destinationAccount String?
  status             String?
  /// Set when reconciled to a Xero bank transaction.
  matchedBankTxnId   String?
  createdAt          DateTime  @default(now())

  entries FcSquarePayoutEntry[]

  @@index([companyId, arrivalDate])
  @@map("fc_square_payouts")
}

model FcSquarePayoutEntry {
  id              String    @id @default(cuid())
  payoutId        String
  companyId       String
  sourceId        String    @unique
  type            String?
  amountCents     Int
  feeCents        Int       @default(0)
  effectiveAt     DateTime?
  paymentSourceId String?

  payout FcSquarePayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId])
  @@map("fc_square_payout_entries")
}

// ── Xero canonical ─────────────────────────────────────────────────────────

model FcXeroAccount {
  id        String   @id @default(cuid())
  companyId String
  sourceId  String
  code      String?
  name      String
  type      String?
  taxType   String?
  isBank    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([companyId, sourceId])
  @@index([companyId, code])
  @@map("fc_xero_accounts")
}

/// Accounts receivable (ACCREC).
model FcXeroInvoice {
  id               String    @id @default(cuid())
  companyId        String
  sourceId         String    @unique
  invoiceNumber    String?
  contactName      String?
  issueDate        DateTime?
  dueDate          DateTime?
  /// Xero P&L figures are GST EXCLUSIVE. netAmount is ex-GST; gross includes.
  netAmountCents   Int       @default(0)
  taxAmountCents   Int       @default(0)
  grossAmountCents Int       @default(0)
  amountDueCents   Int       @default(0)
  status           String?
  updatedAt        DateTime  @updatedAt

  @@index([companyId, dueDate])
  @@map("fc_xero_invoices")
}

/// Accounts payable (ACCPAY).
model FcXeroBill {
  id               String             @id @default(cuid())
  companyId        String
  sourceId         String             @unique
  invoiceNumber    String?
  supplierName     String?
  operationalGroup FcOperationalGroup @default(UNMAPPED)
  issueDate        DateTime?
  dueDate          DateTime?
  netAmountCents   Int                @default(0)
  taxAmountCents   Int                @default(0)
  grossAmountCents Int                @default(0)
  amountDueCents   Int                @default(0)
  status           String?
  paymentTermsDays Int?
  priority         String?
  updatedAt        DateTime           @updatedAt

  @@index([companyId, dueDate])
  @@index([companyId, status])
  @@map("fc_xero_bills")
}

model FcXeroPayment {
  id              String    @id @default(cuid())
  companyId       String
  sourceId        String    @unique
  paidDate        DateTime?
  amountCents     Int
  invoiceSourceId String?
  billSourceId    String?
  bankAccountId   String?
  updatedAt       DateTime  @updatedAt

  @@index([companyId, paidDate])
  @@map("fc_xero_payments")
}

model FcXeroBankTransaction {
  id              String   @id @default(cuid())
  companyId       String
  sourceId        String   @unique
  bankAccountId   String?
  bankAccountName String?
  txnDate         DateTime
  amountCents     Int /// signed: positive receipt, negative payment
  type            String?
  contactName     String?
  reference       String?
  reconciled      Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@index([companyId, txnDate])
  @@map("fc_xero_bank_transactions")
}

// ── Operating data ─────────────────────────────────────────────────────────

/// Starting point for every cash forecast. Actual, not modelled.
model FcBankBalanceSnapshot {
  id             String         @id @default(cuid())
  companyId      String
  asAt           DateTime
  bankAccount    String
  balanceCents   Int
  sourceSystem   FcSourceSystem @default(XERO)
  provenance     FcProvenance   @default(ACTUAL)
  enteredByLabel String?
  notes          String?
  createdAt      DateTime       @default(now())

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, bankAccount, asAt])
  @@index([companyId, asAt])
  @@map("fc_bank_balance_snapshots")
}

/// Gross wages ALREADY CONTAIN PAYG. PAYG is recorded for BAS timing only and
/// must never be added again as a wage cost.
model FcPayrollPeriod {
  id                   String       @id @default(cuid())
  companyId            String
  venueId              String?
  weekStart            DateTime
  weekEnd              DateTime
  grossWagesCents      Int
  superCents           Int          @default(0)
  paygWithheldCents    Int          @default(0)
  hours                Decimal?     @db.Decimal(10, 2)
  headcount            Int?
  overtimeHours        Decimal?     @db.Decimal(10, 2)
  kitchenWagesCents    Int?
  fohWagesCents        Int?
  managementWagesCents Int?
  provenance           FcProvenance @default(ACTUAL)
  notes                String?

  @@unique([companyId, venueId, weekStart])
  @@index([companyId, weekStart])
  @@map("fc_payroll_periods")
}

model FcStocktake {
  id                String       @id @default(cuid())
  companyId         String
  venueId           String?
  stocktakeDate     DateTime
  category          String
  openingStockCents Int          @default(0)
  purchasesCents    Int          @default(0)
  transfersInCents  Int          @default(0)
  transfersOutCents Int          @default(0)
  wastageCents      Int          @default(0)
  staffMealsCents   Int          @default(0)
  closingStockCents Int          @default(0)
  provenance        FcProvenance @default(ACTUAL)

  @@unique([companyId, venueId, stocktakeDate, category])
  @@index([companyId, stocktakeDate])
  @@map("fc_stocktakes")
}

model FcInventoryMovement {
  id           String   @id @default(cuid())
  companyId    String
  venueId      String?
  movementDate DateTime
  category     String
  movementType String /// PURCHASE|TRANSFER_IN|TRANSFER_OUT|WASTAGE|STAFF_MEAL
  amountCents  Int
  reference    String?

  @@index([companyId, movementDate])
  @@map("fc_inventory_movements")
}

model FcBookingsSnapshot {
  id            String   @id @default(cuid())
  companyId     String
  venueId       String?
  serviceDate   DateTime
  snapshotDate  DateTime
  lunchCovers   Int      @default(0)
  dinnerCovers  Int      @default(0)
  totalCovers   Int      @default(0)
  capacity      Int?
  cancellations Int      @default(0)
  noShows       Int      @default(0)
  eventName     String?

  @@unique([companyId, venueId, serviceDate, snapshotDate])
  @@index([companyId, serviceDate])
  @@map("fc_bookings_snapshots")
}

/// Closures, reduced hours, promotions, one-offs. Feeds the abnormal-day flag
/// so the model does not learn from an event it has not been told about.
model FcBusinessEvent {
  id                         String   @id @default(cuid())
  companyId                  String
  venueId                    String?
  dateFrom                   DateTime
  dateTo                     DateTime
  eventType                  String /// CLOSURE|REDUCED_HOURS|PROMOTION|EVENT|MENU_PRICE_CHANGE|ABNORMAL
  expectedSalesImpactPercent Decimal? @db.Decimal(6, 3)
  expectedCostImpactCents    Int?
  excludeFromTraining        Boolean  @default(false)
  approvedForLearning        Boolean  @default(false)
  description                String?
  createdByLabel             String?
  createdAt                  DateTime @default(now())

  @@index([companyId, dateFrom])
  @@map("fc_business_events")
}

model FcRecurringCommitment {
  id           String             @id @default(cuid())
  companyId    String
  venueId      String?
  description  String
  category     FcOperationalGroup
  startDate    DateTime
  endDate      DateTime?
  frequency    String /// WEEKLY|FORTNIGHTLY|MONTHLY|QUARTERLY|ANNUAL|ONE_OFF
  amountCents  Int
  gstTreatment String             @default("EXCLUSIVE") /// EXCLUSIVE|INCLUSIVE|FREE
  paymentDay   Int?
  priority     String?
  scenarioId   String?
  active       Boolean            @default(true)
  provenance   FcProvenance       @default(MANAGEMENT_ASSUMPTION)
  createdAt    DateTime           @default(now())

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, active])
  @@map("fc_recurring_commitments")
}

/// BAS / PAYG / super obligations. Historical ATO and SGC balances are
/// CREDITOR CLAIMS, not recurring operating expenses — those live in
/// fc_creditor_claims instead.
model FcTaxObligation {
  id                  String       @id @default(cuid())
  companyId           String
  obligationType      String /// BAS|PAYG|SUPER|INCOME_TAX
  periodStart         DateTime
  periodEnd           DateTime
  accountingBasis     String       @default("CASH")
  g1GrossSalesCents   Int?
  gst1ACents          Int?
  gst1BCents          Int?
  netGstCents         Int?
  paygCents           Int?
  totalStatementCents Int?
  dueDate             DateTime?
  paidDate            DateTime?
  status              String       @default("ESTIMATED") /// ESTIMATED|DRAFT|LODGED|PAID
  provenance          FcProvenance @default(MODEL_FORECAST)

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, obligationType, periodStart])
  @@index([companyId, dueDate])
  @@map("fc_tax_obligations")
}

// ── Creditors ──────────────────────────────────────────────────────────────

model FcCreditorClaim {
  id                       String          @id @default(cuid())
  companyId                String
  creditorName             String
  creditorClass            FcCreditorClass @default(EXTERNAL_TRADE)
  relatedParty             Boolean         @default(false)
  secured                  Boolean         @default(false)
  priority                 Boolean         @default(false)
  claimedAmountCents       Int             @default(0)
  admittedAmountCents      Int?
  /// Explicit exclusion, on top of the class-based default participation.
  excludedFromDistribution Boolean         @default(false)
  proofOfDebtStatus        String          @default("CLAIMED") /// CLAIMED|ADMITTED|REJECTED|WITHDRAWN
  notes                    String?
  updatedAt                DateTime        @updatedAt

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, creditorClass])
  @@map("fc_creditor_claims")
}

model FcCreditorProposal {
  id                         String       @id @default(cuid())
  companyId                  String
  name                       String
  /// Fixed contribution, contractual. A SNAPSHOT of the rate applied to the
  /// pool estimate below — recompute it when the admitted pool changes.
  fixedTotalCents            Int
  /// The v5 proposal commits a RATE, not a dollar total, so the distribution
  /// recalculates as proofs of debt are admitted with no renegotiation.
  /// Cents per dollar of admitted external claim, 0-100.
  baseCentsInDollar          Decimal?     @db.Decimal(6, 3)
  /// Contingent performance increment, also expressed as cents in the dollar.
  performanceCentsInDollar   Decimal?     @db.Decimal(6, 3)
  /// Working estimate of the admitted external pool the rate is applied to.
  estimatedExternalPoolCents Int?
  /// Share of the distribution paid in each proposal year, e.g. [0, 0.35, 0.65].
  yearShares                 Json         @default("[]")
  /// Share of each year's amount falling in December; the rest in January.
  decemberShare              Decimal?     @db.Decimal(6, 3)
  termMonths                 Int          @default(36)
  /// Performance contribution: share of free cash above the agreed base.
  performanceSharePercent    Decimal      @default(25) @db.Decimal(6, 3)
  performanceCapCents        Int
  /// Deed costs funded from the proposal (reduce what reaches creditors).
  deedCostsCents             Int          @default(0)
  /// Participation switches. Director loans and intercompany default OFF.
  includeDirectorLoans       Boolean      @default(false)
  includeIntercompany        Boolean      @default(false)
  includeSecuredShortfall    Boolean      @default(false)
  includePriorityClaims      Boolean      @default(false)
  includeContingentClaims    Boolean      @default(false)
  status                     String       @default("DRAFT")
  provenance                 FcProvenance @default(PROPOSAL_TERM)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  company   FcCompany                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  schedules FcCreditorPaymentSchedule[]

  @@index([companyId])
  @@map("fc_creditor_proposals")
}

model FcCreditorPaymentSchedule {
  id               String    @id @default(cuid())
  proposalId       String
  companyId        String
  yearNumber       Int
  periodStart      DateTime
  periodEnd        DateTime
  fixedCents       Int       @default(0)
  performanceCents Int       @default(0)
  paidCents        Int       @default(0)
  paidDate         DateTime?
  status           String    @default("SCHEDULED")

  proposal FcCreditorProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("fc_creditor_payment_schedules")
}

// ── Assumptions, overrides, scenarios ──────────────────────────────────────

/// Versioned and editable. Nothing about the model is hardcoded permanently.
model FcAssumption {
  id             String       @id @default(cuid())
  companyId      String
  venueId        String?
  key            String /// "annual_base_sales_cents" | "cogs_target_percent" …
  version        Int          @default(1)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  valueNumeric   Decimal?     @db.Decimal(18, 4)
  valueText      String?
  unit           String? /// "cents" | "percent" | "cents_per_week" …
  provenance     FcProvenance @default(MANAGEMENT_ASSUMPTION)
  /// False until signed off against the creditor workbook.
  confirmed      Boolean      @default(false)
  sourceNote     String?
  authorLabel    String?
  supersededById String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, venueId, key, version])
  @@index([companyId, key, active])
  @@map("fc_assumptions")
}

/// Sits above forecasts, NEVER above an actual source transaction.
model FcOverride {
  id              String       @id @default(cuid())
  companyId       String
  venueId         String?
  metric          String
  adjustmentType  String /// FIXED_REPLACEMENT|DOLLAR_ADJUSTMENT|PERCENT_ADJUSTMENT
  adjustmentValue Decimal      @db.Decimal(18, 4)
  dateFrom        DateTime
  dateTo          DateTime
  priority        Int          @default(100)
  reason          String
  authorLabel     String
  expiresAt       DateTime?
  active          Boolean      @default(true)
  provenance      FcProvenance @default(MANUAL_OVERRIDE)
  createdAt       DateTime     @default(now())

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, metric, active])
  @@map("fc_overrides")
}

model FcScenario {
  id          String   @id @default(cuid())
  companyId   String
  key         String /// BASE|CONSERVATIVE|RECOVERY|custom
  name        String
  description String?
  /// Scenario adjustments as a typed bag; never mutates base assumptions.
  adjustments Json     @default("{}")
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, key])
  @@map("fc_scenarios")
}

// ── Forecast runs and model governance ─────────────────────────────────────

model FcModelVersion {
  id              String    @id @default(cuid())
  family          String /// SALES|MARGIN|CASHFLOW|PAYOUT_TIMING
  version         Int
  algorithm       String /// SEASONAL_NAIVE|MOVING_AVERAGE|TREND_SEASONAL|GBM|ENSEMBLE
  hyperparams     Json      @default("{}")
  features        Json      @default("[]")
  isChampion      Boolean   @default(false)
  promotedAt      DateTime?
  promotedByLabel String?
  retiredAt       DateTime?
  createdAt       DateTime  @default(now())

  runs     FcForecastRun[]
  accuracy FcModelAccuracyResult[]

  @@unique([family, version])
  @@index([family, isChampion])
  @@map("fc_model_versions")
}

/// One reproducible forecast execution.
model FcForecastRun {
  id                 String    @id @default(cuid())
  companyId          String
  scenarioId         String?
  modelVersionId     String?
  family             String
  horizonStart       DateTime
  horizonEnd         DateTime
  granularity        String /// DAILY|WEEKLY|MONTHLY
  /// Everything needed to reproduce this run byte for byte.
  assumptionSnapshot Json      @default("{}")
  overrideSnapshot   Json      @default("[]")
  featureSet         Json      @default("[]")
  sourceDataCutoff   DateTime
  trainingStart      DateTime?
  trainingEnd        DateTime?
  selectionReason    String?
  generatedAt        DateTime  @default(now())
  generatedByLabel   String?

  company      FcCompany         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  modelVersion FcModelVersion?   @relation(fields: [modelVersionId], references: [id])
  points       FcForecastPoint[]

  @@index([companyId, family, generatedAt])
  @@map("fc_forecast_runs")
}

model FcForecastPoint {
  id           String       @id @default(cuid())
  runId        String
  companyId    String
  venueId      String?
  periodStart  DateTime
  periodEnd    DateTime
  metric       String
  centralCents Int
  lower80Cents Int?
  upper80Cents Int?
  lower95Cents Int?
  upper95Cents Int?
  provenance   FcProvenance @default(MODEL_FORECAST)
  /// Set when a manual override changed this point, for the audit trail.
  overrideId   String?

  run FcForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, metric, periodStart])
  @@index([companyId, metric, periodStart])
  @@map("fc_forecast_points")
}

model FcModelAccuracyResult {
  id                  String   @id @default(cuid())
  modelVersionId      String
  companyId           String
  family              String
  metric              String
  windowStart         DateTime
  windowEnd           DateTime
  wape                Decimal? @db.Decimal(10, 4)
  mae                 Decimal? @db.Decimal(18, 4)
  rmse                Decimal? @db.Decimal(18, 4)
  bias                Decimal? @db.Decimal(18, 4)
  mape                Decimal? @db.Decimal(10, 4)
  directionalAccuracy Decimal? @db.Decimal(10, 4)
  sampleCount         Int      @default(0)
  computedAt          DateTime @default(now())

  modelVersion FcModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  @@index([companyId, family, windowStart])
  @@map("fc_model_accuracy_results")
}

// ── Quality and audit ──────────────────────────────────────────────────────

model FcDataQualityIssue {
  id              String     @id @default(cuid())
  companyId       String
  checkKey        String
  severity        FcSeverity @default(WARNING)
  entityType      String?
  entityId        String?
  businessDate    DateTime?
  message         String
  detail          Json?
  resolved        Boolean    @default(false)
  resolvedAt      DateTime?
  resolvedByLabel String?
  detectedAt      DateTime   @default(now())

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, severity, resolved])
  @@index([checkKey])
  @@map("fc_data_quality_issues")
}

model FcAuditEvent {
  id         String   @id @default(cuid())
  companyId  String
  entityType String
  entityId   String?
  action     String
  before     Json?
  after      Json?
  reason     String?
  actorId    String?
  actorLabel String?
  createdAt  DateTime @default(now())

  company FcCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, entityType, createdAt])
  @@map("fc_audit_events")
}

/// Resumable sync position per company/source/entity. A sync that dies
/// mid-run restarts from here rather than re-downloading history.
model FcSyncCursor {
  id                String         @id @default(cuid())
  companyId         String
  sourceSystem      FcSourceSystem
  /// "payouts" | "orders" | "bank_transactions" | "invoices" …
  sourceEntity      String
  /// Opaque provider cursor (Square) — resume token within a page walk.
  cursor            String?
  /// High-water mark for modified-since style incremental sync (Xero).
  lastModifiedAt    DateTime?
  /// Newest business date successfully ingested.
  lastBusinessDate  DateTime?
  lastSuccessfulAt  DateTime?
  lastError         String?
  consecutiveErrors Int            @default(0)
  updatedAt         DateTime       @updatedAt

  @@unique([companyId, sourceSystem, sourceEntity])
  @@index([companyId, sourceSystem])
  @@map("fc_sync_cursors")
}

/// One sync execution, for the visible last-successful-sync status.
model FcSyncRun {
  id                String         @id @default(cuid())
  companyId         String
  sourceSystem      FcSourceSystem
  sourceEntity      String
  status            String         @default("RUNNING") /// RUNNING|SUCCESS|PARTIAL|FAILED
  startedAt         DateTime       @default(now())
  finishedAt        DateTime?
  pagesFetched      Int            @default(0)
  recordsFetched    Int            @default(0)
  recordsWritten    Int            @default(0)
  duplicatesSkipped Int            @default(0)
  rateLimitHits     Int            @default(0)
  windowStart       DateTime?
  windowEnd         DateTime?
  error             String?
  triggeredBy       String? /// "cron" | "manual" | "webhook" | "backfill"

  @@index([companyId, sourceSystem, startedAt])
  @@map("fc_sync_runs")
}

// ── Alma POS (counter-mode register MVP) ─────────────────────────────────────
// @domain: pos | home: suite
model PosOrder {
  id                  String                @id @default(cuid())
  orderNumber         Int                   @unique @default(autoincrement())
  venue               String
  // Client-generated key for offline-queued sales: replaying a sync request
  // (double flush, retry after a timed-out-but-committed create) can never
  // duplicate the order.
  idempotencyKey      String?               @unique
  // Training-mode orders exercise the full register flow but are excluded
  // from actuals, drawers, day close, shift reports and guest CRM.
  training            Boolean               @default(false)
  // UTC midnight of the Sydney trading day the order was PAID on (null while open).
  serviceDate         DateTime?
  status              String                @default("OPEN") // OPEN | PAID | VOID
  subtotalCents       Int                   @default(0) // inc GST, before discount/surcharge
  discountCents       Int                   @default(0)
  discountLabel       String?
  // Manual (staff-applied, reason-audited) discount on top of rule discounts.
  manualDiscountCents Int                   @default(0)
  manualDiscountLabel String?
  surchargeCents      Int                   @default(0)
  surchargeLabel      String?
  totalCents          Int                   @default(0) // inc GST, after discount + surcharge
  gstCents            Int                   @default(0) // 1/11 of total (GST-inclusive pricing)
  tipCents            Int                   @default(0)
  tableLabel          String?
  covers              Int?
  // Matched guest (via tonight's reservation on this table) — feeds the CRM:
  // spend, visits and favourite items update when the order settles.
  guestId             String?
  reservationId       String?
  notes               String?
  // Dietary flags: [{tag, seat|null}] — seat null applies to the whole table.
  dietary             Json                  @default("[]")
  // DINE_IN | TAKEAWAY — the kitchen plates and packs differently, so it
  // prints at the top of every docket.
  orderType           String                @default("DINE_IN")
  openedByName        String?
  guest               ReserveGuest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  paidAt              DateTime?
  voidedAt            DateTime?
  voidReason          String?
  giftCardSales       PosGiftCardSale[]
  terminalCheckouts   PosTerminalCheckout[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lines               PosOrderLine[]
  payments            PosPayment[]
  terminalRefunds     PosTerminalRefund[]

  @@index([venue, serviceDate])
  @@index([status])
}

model PosOrderLine {
  id             String    @id @default(cuid())
  orderId        String
  recipeId       String?
  name           String
  // Docket/KDS name, captured from Recipe.printTitle (falling back to title)
  // at the moment this line was added. NULL means "use name" — dockets and
  // KDS tickets read this in preference to `name`; the register tile, bill
  // and guest receipt always use `name`.
  printName      String?
  unitPriceCents Int
  quantity       Int
  totalCents     Int
  course         String?
  seat           Int?
  // Chosen modifiers: [{name, priceCents}] — unitPriceCents already includes
  // their deltas; dockets print them under the item.
  modifiers      Json?
  notes          String?
  // A face-value voucher, not food: no GST at sale, no surcharge, no
  // discount, never sent to the kitchen. Rebuilt from PosGiftCardSale, so
  // a client line edit can never lose or duplicate it.
  isGiftCard     Boolean   @default(false)
  // The set menu this line was included in — the recipeId of the package that
  // paid for it. Set on the $0 dish lines a banquet rings, NULL on everything
  // sold on its own. Stamped here rather than inferred from a $0 price or a
  // note, so the banquet report can tell an included dish from a comp, and so
  // it survives the line rewrite every bill edit does.
  packagedBy     String?
  // Set when the line's course has been FIRED to its printer profile.
  sentAt         DateTime?
  // Who called it away. With sentAt this is the kitchen-performance trail:
  // ordered at (createdAt) → fired at (sentAt) → by whom.
  sentByName     String?
  createdAt      DateTime  @default(now())
  order          PosOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipe         Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([recipeId])
  @@index([packagedBy])
}

// A gift card being SOLD on a bill. The card itself is only issued when the
// bill settles — an unpaid or voided bill must never put a live card in
// someone's hand. Linked to the order, not the line: setLines deletes and
// recreates every line, so line ids are not stable.
// Every employmentStatus transition, with a stack so a silent deactivation
// is traceable to its caller instead of being guessed at. Written by the
// Prisma guard in packages/db/src/prisma.ts.
model StaffStatusChange {
  id             String   @id @default(cuid())
  staffProfileId String
  fromStatus     String
  toStatus       String
  source         String   @default("unknown")
  stack          String?
  createdAt      DateTime @default(now())

  @@index([staffProfileId])
  @@index([createdAt])
}

model PosGiftCardSale {
  id             String    @id @default(cuid())
  orderId        String
  amountCents    Int
  // A pre-printed card the guest is buying, if the venue has stock.
  requestedCode  String?
  recipientName  String?
  recipientEmail String?
  // Filled in at settle.
  issuedCode     String?
  issuedAt       DateTime?
  createdAt      DateTime  @default(now())
  order          PosOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PosPayment {
  id            String   @id @default(cuid())
  orderId       String
  method        String // CASH | CARD_EXTERNAL | STRIPE_TERMINAL
  amountCents   Int
  tipCents      Int      @default(0)
  tenderedCents Int?
  changeCents   Int?
  reference     String?
  createdAt     DateTime @default(now())
  order         PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Automatic pricing rules: weekend/public-holiday surcharges and timed
// discounts (happy hour). Applied server-side on every order recompute.
// Cash drawer sessions: float in, denomination count out, variance recorded.
model PosDrawer {
  id                String    @id @default(cuid())
  venue             String
  status            String    @default("OPEN") // OPEN | CLOSED
  openingFloatCents Int       @default(0)
  countedCents      Int?
  expectedCents     Int?
  varianceCents     Int?
  // {"10000": 3, "5000": 5, ...} — cents denomination → quantity counted.
  denominations     Json?
  openedByName      String?
  closedByName      String?
  notes             String?
  openedAt          DateTime  @default(now())
  closedAt          DateTime?

  @@index([venue, status])
}

// One close-of-day per venue per trading day — the audit record.
model PosDayClose {
  id           String   @id @default(cuid())
  venue        String
  serviceDate  DateTime
  report       Json
  closedByName String?
  createdAt    DateTime @default(now())

  @@unique([venue, serviceDate])
}

// Ordered course list shown on the register (tap-to-cycle + docket grouping).
model PosCourse {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

// Docket routing: which kinds/categories print where (kitchen vs bar).
// Server Direct Print queue: the PRINTER polls our API over HTTPS for
// jobs, so browsers never need LAN access and iPads just work.
model PosPrintJob {
  id        String    @id @default(cuid())
  profileId String
  status    String    @default("QUEUED") // QUEUED | SENT | PRINTED | FAILED
  payload   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  doneAt    DateTime?

  @@index([profileId, status, createdAt])
}

model PosPrinterProfile {
  id            String  @id @default(cuid())
  name          String
  // Which venue's stations these are. NULL = every venue (how it behaved
  // before there was a second venue). Two venues sharing a station would
  // print St Alma's dockets in Avalon's kitchen.
  venue         String?
  // FOOD or BEVERAGE — the default router; categoriesCsv narrows/overrides.
  matchKind     String
  categoriesCsv String  @default("")
  printerIp     String?
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
}

// Audited register actions: every discount, comp, price change and wastage
// records WHO did it, the ITEM, and a mandatory reason from the fixed list.
model PosAdjustment {
  id          String   @id @default(cuid())
  venue       String
  orderId     String?
  kind        String // DISCOUNT | COMP | PRICE_CHANGE | WASTAGE
  reason      String
  staffName   String
  itemName    String?
  amountCents Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([venue, createdAt])
  @@index([kind])
}

// Per-operator POS homescreen: which management buttons show + pinned items.
model PosHomescreen {
  id              String   @id @default(cuid())
  userKey         String   @unique
  buttons         Json
  pins            Json
  // Per-user category tab bar: {order: string[], hidden: string[],
  // groups: [{name, cats: string[], c?}]}. Null = the menu's natural order.
  categories      Json?
  // Management tile sizes: { 'open-till': 'w' | 'b' } — same vocabulary as pins.
  buttonSizes     Json?
  landingCategory String?
  updatedBy       String?
  updatedAt       DateTime @updatedAt
}

// Modifier groups attach to menu CATEGORIES (low-config): "Taco mods" applies
// to every item in Tacos. Options can carry a price delta.
model PosModifierGroup {
  id            String        @id @default(cuid())
  name          String
  categoriesCsv String        @default("")
  required      Boolean       @default(false)
  maxSelect     Int           @default(3)
  sortOrder     Int           @default(0)
  active        Boolean       @default(true)
  options       PosModifier[]
}

model PosModifier {
  id         String           @id @default(cuid())
  groupId    String
  name       String
  priceCents Int              @default(0)
  sortOrder  Int              @default(0)
  active     Boolean          @default(true)
  group      PosModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// The 86 list: sold-out items, greyed on every register instantly.
// Menu curation: entries hidden from every register + the QR menu (86 is
// "sold out today"; a hide is "we don't sell this here"). kind ITEM keys by
// recipeId, kind CATEGORY keys by category name.
model PosMenuHide {
  id        String   @id @default(cuid())
  kind      String
  key       String
  hiddenBy  String?
  createdAt DateTime @default(now())

  @@unique([kind, key])
}

model Pos86 {
  id        String   @id @default(cuid())
  recipeId  String   @unique
  staffName String?
  createdAt DateTime @default(now())
}

// A fired docket, persisted for the kitchen display: one ticket per station
// per fire. Bumped tickets drop off the rail (recallable).
model PosTicket {
  id           String    @id @default(cuid())
  venue        String
  station      String
  orderId      String
  orderNumber  Int
  tableLabel   String?
  covers       Int?
  openedByName String?
  lines        Json
  firedAt      DateTime  @default(now())
  bumpedAt     DateTime?

  @@index([venue, station, bumpedAt])
}

// Per-venue register behaviour: when the POS is the venue's till, settled
// sales/covers/tips post into the suite's actuals tables.
// A Square Terminal (handheld or Stand) paired to a venue. We hold the pairing
// only — the card data and the money never touch us, which is the whole point
// of driving the hardware through Square's Terminal API rather than reading a
// card ourselves.
model PosTerminalDevice {
  id             String                @id @default(cuid())
  venue          String
  name           String
  // Square's device-code record. The 8-character `code` is what staff type
  // into the terminal once; `deviceCodeId` is how we poll Square to find out
  // whether they've done it yet.
  deviceCodeId   String                @unique
  code           String
  // Square fills this in when the code is redeemed on the hardware. Until
  // then there is nothing to send a checkout to.
  squareDeviceId String?
  status         String                @default("PAIRING") // PAIRING | PAIRED | EXPIRED
  locationId     String
  accountKey     String // primary (St Alma) | secondary (Alma Avalon)
  pairedAt       DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  checkouts      PosTerminalCheckout[]
  refunds        PosTerminalRefund[]

  @@index([venue, status])
}

// One attempt to charge a card on a terminal.
//
// This row exists so polling is idempotent. The register asks "done yet?"
// every second or two, and a slow network can deliver the same COMPLETED
// twice — `paymentId` is the latch that makes sure the bill is only ever
// tendered once, no matter how many times we ask.
model PosTerminalCheckout {
  id              String            @id // Square's checkout id
  orderId         String
  deviceId        String
  venue           String
  amountCents     Int
  tipCents        Int               @default(0)
  status          String            @default("PENDING") // PENDING | IN_PROGRESS | CANCEL_REQUESTED | COMPLETED | CANCELED
  squarePaymentId String?
  paymentId       String?
  failureReason   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           PosOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  device          PosTerminalDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// One attempt to push a refund back to a Square Terminal — the mirror of
// PosTerminalCheckout, latch and all. `refundPaymentId` is set exactly once,
// when Square first reports the refund COMPLETED, so a repeated poll cannot
// credit the bill twice.
//
// The manager who approved it is recorded here at START, before the card is
// touched. The PIN itself is never stored.
model PosTerminalRefund {
  id              String            @id // Square's terminal refund id
  orderId         String
  deviceId        String
  venue           String
  amountCents     Int
  status          String            @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | CANCELED
  squarePaymentId String // the original payment being refunded
  approvedBy      String
  staffName       String
  reason          String
  refundPaymentId String?
  failureReason   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           PosOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  device          PosTerminalDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// A bug reported from the register by whoever hit it, while they still
// remember what they were doing. The point is that a problem at 7pm on a
// Friday costs a server fifteen seconds, not a phone call to someone who
// wasn't there — so the form asks almost nothing and the register attaches
// the context itself.
model PosBugReport {
  id          String    @id @default(cuid())
  venue       String
  // What they were doing and what happened. One box, their words.
  body        String
  // Auto-attached by the register: which screen, which bill, which build,
  // which device. This is what makes a one-line report actionable.
  screen      String?
  orderId     String?
  appVersion  String?
  userAgent   String?
  reportedBy  String?
  // Recent console errors, if the browser had any.
  clientError String?
  severity    String    @default("NORMAL") // NORMAL | BLOCKING
  status      String    @default("NEW") // NEW | TRIAGED | FIXED | WONTFIX | NEEDS_INFO
  // Filled in when it's worked: what was wrong and what changed.
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

// A guest's QR round, held here until Square says it's paid.
//
// The whole point is that NOTHING touches the table's bill or the kitchen
// until the money is in. An abandoned checkout leaves a dead row here rather
// than phantom items a server has to notice and strip out mid-service.
//
// `lines` is the SERVER's priced copy, not the client's — the basket is
// repriced at submit and never re-read from the browser afterwards.
model PosQrPendingOrder {
  id                  String    @id @default(cuid())
  venue               String
  tableLabel          String
  guestName           String?
  notes               String?
  dietary             Json      @default("[]")
  lines               Json
  totalCents          Int
  squarePaymentLinkId String?
  squareOrderId       String?
  checkoutUrl         String?
  status              String    @default("PENDING") // PENDING | PAID | EXPIRED
  // Set exactly once, when the paid basket becomes real lines on a bill.
  // This is the latch that stops a refreshed success page ordering twice.
  posOrderId          String?
  paidAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([venue, tableLabel])
}

model PosVenueSetting {
  id                  String  @id @default(cuid())
  venue               String  @unique
  // Each venue is its own company — receipts and payments carry its identity.
  businessName        String?
  abn                 String?
  address             String?
  phone               String?
  email               String?
  website             String?
  // Receipt logo as a data URL (downscaled on upload in the Office).
  receiptLogo         String?
  postToReports       Boolean @default(false)
  // Xero: which organisation this venue's takings post to, and the account
  // codes the daily sales invoice uses. Blank tenant = never posts.
  xeroTenantId        String?
  xeroSalesAccount    String? // default 200 (Sales)
  xeroTipsAccount     String? // blank = tips stay out of the invoice
  xeroCashAccount     String? // clearing account cash lands in
  xeroCardAccount     String? // clearing account card settlements land in
  xeroGiftCardAccount String? // gift-card redemptions (liability drawdown)
}

model PosRule {
  id          String   @id @default(cuid())
  kind        String // SURCHARGE | DISCOUNT
  label       String
  percent     Float
  weekdays    String // csv of JS weekday numbers 0-6, '' = none
  holidays    Boolean  @default(false)
  startMinute Int?
  endMinute   Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One row per (staff member, Xero organisation).
//
// St Alma trades as Alma Freshwater Pty Ltd and Alma Avalon is a separate
// company: separate ABNs, separate payrolls, separate employee records. So
// somebody rostered across both is TWO employees in Xero, and a single
// StaffProfile.xeroEmployeeId cannot say which company the id belongs to —
// which is exactly why Isla could not be pushed to both.
model StaffXeroEmployee {
  id             String       @id @default(cuid())
  staffProfileId String
  // Xero tenant (organisation) id, and its name kept alongside so the UI can
  // say "Alma Freshwater Pty Ltd" without another API call.
  tenantId       String
  tenantName     String?
  xeroEmployeeId String
  // Null until we have actually pushed/matched; set on every successful sync.
  syncedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, tenantId])
  @@index([tenantId])
  @@index([xeroEmployeeId])
}

/// One browser, on one device, that has agreed to be told when a roster drops.
///
/// Keyed by endpoint because that is what the browser gives us and what the
/// push service accepts — a person legitimately has several (phone, iPad,
/// the desktop they do admin on), and reinstalling the app produces a new
/// one rather than reusing the old.
///
/// Rows are deleted, never soft-disabled, when the push service says the
/// endpoint is gone (404/410). A dead endpoint is not a state worth keeping:
/// it can never come back, and the browser mints a fresh row on re-subscribe.
model StaffPushSubscription {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  /// The push service URL. Unique across everyone: if a device is handed to
  /// another staff member and they subscribe, the row moves to them rather
  /// than the old owner keeping a feed of somebody else's shifts.
  endpoint       String       @unique
  /// The subscription's public key and auth secret, base64url as the browser
  /// gave them. Used to encrypt each payload to that device.
  p256dh         String
  auth           String
  /// What asked for it, so a manager chasing "I'm not getting them" can see
  /// whether the phone ever registered at all.
  userAgent      String?
  createdAt      DateTime     @default(now())
  lastSuccessAt  DateTime?
  /// Consecutive send failures that were not a hard "gone". Enough of them and
  /// it is worth a human look, but they do not stop us trying.
  failureCount   Int          @default(0)

  @@index([staffProfileId])
}

// @domain: pos | home: suite
// A price a dish takes on particular weekdays — Taco Tuesday rings the tacos
// at $5 without anybody re-keying prices on the day. The register applies the
// window at render/ring time (device-local day, so an offline register stays
// right), and the QR flow applies it server-side in the venue's timezone —
// QR prices are never trusted from the client.
//
// onlyWindow makes the window the dish's ONLY life: outside it the dish is
// not offered at all (the "Try them all" taco board exists on Tuesdays and
// nowhere else). A dish with no windows sells all week at its normal price.
model PosPriceWindow {
  id         String   @id @default(cuid())
  recipeId   String
  // Shown nowhere yet — carried so a report can say WHY a line rang at $5.
  label      String
  // csv of JS weekday numbers 0-6, same shape as PosRule.weekdays.
  weekdays   String
  priceCents Int
  onlyWindow Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([recipeId])
}
