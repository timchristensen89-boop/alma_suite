  status               StocktakeStatus       @default(IN_PROGRESS)
  notes                String?
  appliedAt            DateTime?
  submittedAt          DateTime?
  submittedByUserId    String?
  reviewedAt           DateTime?
  reviewedByUserId     String?
  lockedAt             DateTime? // once locked, reports prefer this stocktake
