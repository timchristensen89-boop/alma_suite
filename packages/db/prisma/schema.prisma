// @domain: workforce | home: workforce
model RosterShift {
  id                      String                   @id @default(cuid())
  /// NULL means the shift is OPEN — nobody is on it yet. Open shifts are how
  /// a manager publishes work that needs filling, and what staff can claim.
  /// Before this was nullable, "open" was faked with placeholder staff
  /// profiles named Unallocated, which put fake people in the team list.
  staffProfileId          String?
  venue                   String?
  area                    String?
  roleTitle               String?
  startsAt                DateTime
  endsAt                  DateTime
  breakMinutes            Int                      @default(0)
  status                  RosterShiftStatus        @default(DRAFT)
  notes                   String?
  /// A shift whose holder has offered to swap it away. offeredAt being set is
  /// what makes it visible to the rest of the team; offeredByStaffProfileId
  /// records WHO offered it, so a manager reassigning the shift while an offer
  /// is live cannot make it read as though the new holder offered it.
  offeredAt               DateTime?
  offeredByStaffProfileId String?
  offerNote               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  staffProfile            StaffProfile?            @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  offeredBy               StaffProfile?            @relation("RosterShiftOfferedBy", fields: [offeredByStaffProfileId], references: [id], onDelete: SetNull)
  shiftConfirmations      StaffShiftConfirmation[]
  shiftTaskAssignments    ShiftTaskAssignment[]
  clockSessions           StaffClockSession[]
  claims                  RosterShiftClaim[]

  @@index([staffProfileId, startsAt])
  @@index([startsAt, endsAt])
}

