// @domain: compliance | home: suite
model Issue {
  id                String           @id @default(cuid())
  legacyId          String?          @unique
  title             String
  description       String
  severity          IssueSeverity
  category          String
  area              String?
  status            IssueStatus      @default(OPEN)
  assignee          String?
  dueDate           DateTime?
  notes             String?
  resolutionNotes   String?
  // Who raised it. The activity log has carried the reporter's NAME since the
  // beginning, but a name is not an identity — they collide, they change, and
  // a person can hold two staff profiles. The id is what makes "issues I
  // reported" answerable.
  // Who owns it. `assignee` has always been a free-text name, which is why a
  // third of the open backlog still points at someone who left months ago —
  // an area rule kept writing their name and nothing could tell.
  assigneeStaffId   String?
  reportedByStaffId String?
  reportedByName    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  evidence          IssueEvidence[]
  activities        IssueActivity[]
  checklistLinks    ChecklistItem[]
  auditLinks        AuditFinding[]
  incidentLinks     IncidentReport[]
}

// @domain: compliance | home: suite
model IssueEvidence {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  issueId   String
  name      String
  url       String
  fileType  String?
  note      String?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

// Area → default responsible person. When an issue is created/assigned to an
// area, it is auto-assigned to this person (Issue.assignee is free text, so we
// store the display name to match). Managed in Admin → Compliance settings.
// @domain: compliance | home: suite
model IssueAreaRule {
  id        String   @id @default(cuid())
  area      String   @unique
  assignee  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-managed list of issue categories. Staff pick from these in the
// issue form (free-text only when none are configured).
// @domain: compliance | home: suite
model IssueCategoryOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// @domain: compliance | home: suite
model IssueActivity {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  issueId   String
  action    String
  message   String
  actor     String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

// @domain: compliance | home: suite
model ChecklistTemplate {
  id                   String                  @id @default(cuid())
  legacyId             String?                 @unique
  name                 String
  area                 String?
  // How often the daily scheduler should raise a run from this template.
  // DAILY | WEEKDAYS | WEEKLY | MONTHLY | MANUAL. cadenceDay is the weekday
  // (0 = Sunday) for WEEKLY and the day of the month for MONTHLY.
  cadence              String                  @default("DAILY")
  cadenceDay           Int?
  items                ChecklistItemTemplate[]
  runs                 ChecklistRun[]
  shiftTaskRules       ShiftTaskRule[]
  shiftTaskAssignments ShiftTaskAssignment[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
}

// @domain: compliance | home: suite
model ChecklistItemTemplate {
  id          String            @id @default(cuid())
  legacyId    String?           @unique
  templateId  String
  label       String
  description String?
  position    Int
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// @domain: compliance | home: suite
model ChecklistRun {
  id                   String                @id @default(cuid())
  legacyId             String?               @unique
  templateId           String
  runDate              DateTime              @default(now())
  status               ChecklistRunStatus    @default(OPEN)
  area                 String?
  performedBy          String?
  notes                String?
  template             ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items                ChecklistItem[]
  shiftTaskAssignments ShiftTaskAssignment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

// @domain: compliance | home: suite
model ChecklistItem {
  id             String              @id @default(cuid())
  legacyId       String?             @unique
  runId          String
  templateItemId String?
  label          String
  description    String?
  position       Int
  result         ChecklistItemResult @default(PENDING)
  notes          String?
  linkedIssueId  String?
  run            ChecklistRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  linkedIssue    Issue?              @relation(fields: [linkedIssueId], references: [id])
}

// @domain: compliance | home: suite
model AuditTemplate {
  id        String                 @id @default(cuid())
  legacyId  String?                @unique
  name      String
  sections  AuditTemplateSection[]
  runs      AuditRun[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

// @domain: compliance | home: suite
model AuditTemplateSection {
  id          String        @id @default(cuid())
  legacyId    String?       @unique
  templateId  String
  title       String
  description String?
  position    Int
  template    AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// @domain: compliance | home: suite
model AuditRun {
  id         String         @id @default(cuid())
  legacyId   String?        @unique
  templateId String
  title      String
  score      Float?
  summary    String?
  runDate    DateTime       @default(now())
  template   AuditTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  findings   AuditFinding[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// @domain: compliance | home: suite
model AuditFinding {
  id            String   @id @default(cuid())
  legacyId      String?  @unique
  auditRunId    String
  sectionTitle  String
  finding       String
  score         Float?
  linkedIssueId String?
  auditRun      AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  linkedIssue   Issue?   @relation(fields: [linkedIssueId], references: [id])
}

// @domain: people-core | home: suite
model StaffProfile {
  id                           String                     @id @default(cuid())
  firstName                    String
  lastName                     String
  roleTitle                    String
  email                        String?                    @unique
  phone                        String?
  venue                        String?
  /// Secret in the URL of this person's calendar feed. Apple and Google
  /// Calendar cannot carry a login when they poll a subscription, so the token
  /// IS the credential — long, random, and rotatable by the holder or a
  /// manager if a phone goes missing. Null until they first ask for the link.
  calendarToken                String?                    @unique
  calendarTokenIssuedAt        DateTime?
  employmentStatus             String                     @default("ACTIVE")
  accountType                  StaffAccountType           @default(HUMAN)
  startDate                    DateTime?
  dateOfBirth                  DateTime?
  addressLine1                 String?
  addressLine2                 String?
  suburb                       String?
  state                        String?
  postcode                     String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  employmentType               String?
  // Agreed weekly hours for FT/PT (e.g. 38, 24). The labour view measures
  // rostered hours against this; NULL means not set (casuals never set it).
  contractedWeeklyHours        Int?
  payType                      String?
  payRateCents                 Int?
  payAward                     String?
  taxFileNumber                String?
  taxResidencyStatus           String?
  taxFreeThreshold             Boolean?
  hasStudyTrainingLoan         Boolean?
  superFundName                String?
  superFundAbn                 String?
  superFundUsi                 String?
  superMemberNumber            String?
  bankAccountName              String?
  bankBsb                      String?
  bankAccountNumber            String?
  visaStatus                   String?
  visaSubclass                 String?
  visaExpiryDate               DateTime?
  workRightsNotes              String?
  xeroEmployeeId               String?
  xeroEmployees                StaffXeroEmployee[]
  xeroPayrollCalendarId        String?
  xeroEarningsRateId           String?
  defaultArea                  String?
  trainingLevel                Int                        @default(0)
  trainingPayRateCents         Int?
  notes                        String?
  mergedIntoStaffProfileId     String?
  mergedAt                     DateTime?
  mergedByUserId               String?
  passwordHash                 String?
  pinHash                      String?
  pinUpdatedAt                 DateTime?
  pinFailedAttempts            Int                        @default(0)
  pinLockedUntil               DateTime?
  // POS abilities for non-managers: {refunds, voids, discounts, till, office}.
  posPermissions               Json                       @default("{}")
  /// A practice account. Everything it opens at the register is a training
  /// sale — no takings, no drawer, no reports, nothing to the kitchen.
  ///
  /// It lives HERE, on the account, rather than in the browser, because the
  /// old training switch was `alma.pos.training` in localStorage: a per-DEVICE
  /// toggle that starts OFF. Hand someone a login and they get a live till on
  /// their own phone regardless of what you meant. This flag travels with the
  /// account instead, is forced on server-side at order creation, and cannot
  /// be turned off from the till.
  ///
  /// Two uses, one mechanism: a new starter you want on a real-looking register
  /// that cannot cost you anything, and an App Review demo login.
  trainingOnly                 Boolean                    @default(false)
  pinLastFailedAt              DateTime?
  isAdmin                      Boolean                    @default(false)
  lastLoginAt                  DateTime?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  records                      StaffComplianceRecord[]
  hrRecords                    StaffHrRecord[]
  managerNotes                 StaffManagerNote[]
  shiftClaims                  RosterShiftClaim[]
  availability                 StaffAvailability[]
  unavailability               StaffUnavailability[]
  payProfile                   StaffPayProfile?
  managementEvents             StaffManagementEvent[]
  leaveRequests                StaffLeaveRequest[]
  passwordResetTokens          StaffPasswordResetToken[]
  appAccess                    StaffAppAccess[]
  roleTemplateId               String?
  roleTemplate                 StaffRoleTemplate?         @relation(fields: [roleTemplateId], references: [id], onDelete: SetNull)
  rosterShifts                 RosterShift[]
  offeredRosterShifts          RosterShift[]              @relation("RosterShiftOfferedBy")
  shiftTaskAssignments         ShiftTaskAssignment[]
  shiftConfirmations           StaffShiftConfirmation[]
  clockSessions                StaffClockSession[]
  clockEvents                  StaffClockEvent[]
  timesheets                   Timesheet[]
  trainingRecords              StaffTrainingRecord[]
  tipPaymentRunLines           StaffTipPaymentRunLine[]
  tipManualHoursEntries        StaffTipManualHoursEntry[]
  triagedSupplierInvoices      SupplierInvoice[]          @relation("SupplierInvoiceTriagedBy")
  assignedSupplierInvoices     SupplierInvoice[]          @relation("SupplierInvoiceAssignedTo")
  ownedAlmaTasks               AlmaTask[]                 @relation("AlmaTaskOwner")
  completedAlmaTasks           AlmaTask[]                 @relation("AlmaTaskCompletedBy")
  dismissedAlmaTasks           AlmaTask[]                 @relation("AlmaTaskDismissedBy")
  pushSubscriptions            StaffPushSubscription[]

  @@index([venue])
  @@index([accountType, venue])
  @@index([roleTemplateId])
  @@index([mergedIntoStaffProfileId])
  @@index([xeroEmployeeId])
}

