// @domain: workforce | home: workforce
/// A staff member putting their hand up for an open shift.
///
/// A claim is a request, not an assignment: two people can claim the same
/// shift and a manager decides. That is deliberate — auto-assigning to
/// whoever taps first rewards whoever happens to be holding their phone,
/// and hides the choice from the person accountable for the roster.
model RosterShiftClaim {
  id             String    @id @default(cuid())
  rosterShiftId  String
  staffProfileId String
  status         String    @default("PENDING") /// PENDING|APPROVED|DECLINED|WITHDRAWN
  note           String?
  decidedAt      DateTime?
  decidedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rosterShift  RosterShift  @relation(fields: [rosterShiftId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  /// One claim per person per shift; re-claiming updates the existing row.
  @@unique([rosterShiftId, staffProfileId])
  @@index([staffProfileId, status])
  @@map("roster_shift_claims")
}

